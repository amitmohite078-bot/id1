# ==========================================
# SalonBridge Environment Configuration
# Copy to .env (and app-specific .env.local)
# ==========================================

NODE_ENV=development

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgresql://salonbridge:salonbridge_dev@localhost:5432/salonbridge

# Redis (BullMQ + Rate Limits + Cache)
REDIS_URL=redis://localhost:6379

# Object Storage (MinIO local / Cloudflare R2 / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=ap-south-1
S3_BUCKET=salonbridge-media
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true

# API Server
API_PORT=4000
API_HOST=0.0.0.0
API_BASE_URL=http://localhost:4000
COOKIE_SECRET=dev-cookie-secret-change-in-production-32chars
JWT_ACCESS_SECRET=dev-jwt-access-secret-change-in-prod-32chars
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-in-prod-32chars
ADMIN_2FA_ENCRYPTION_KEY=dev-32-byte-hex-key-for-totp-secret-enc

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# Super Admin IP Allow-list (optional comma-separated CIDRs/IPs; empty = allow all in dev)
ADMIN_IP_ALLOWLIST=

# Auth & Notifications (mock | twilio_whatsapp | resend)
OTP_PROVIDER=mock
EMAIL_PROVIDER=mock
WHATSAPP_PROVIDER=mock
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
RESEND_API_KEY=
EMAIL_FROM=noreply@salonbridge.in

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Menu Extraction (Anthropic Claude)
ANTHROPIC_API_KEY=

# Payments (Razorpay Route)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Maps / Geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_API_URL=http://localhost:4000

